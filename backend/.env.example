# Copia a backend/.env (no versionado). Todas obligatorias salvo las marcadas.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@HOST:5432/incubus
# Origenes del frontend (coma). Con credenciales: el navegador envia cookies y DPoP.
CORS_ORIGINS=http://localhost:3000,http://localhost:3200
# URL base de la API de Vladimir (catalogo de examenes).
VLADIMIR_API_URL=http://localhost:8000
# Leo: SSO de usuarios (BFF /auth/*) y credenciales de servicio hacia Vladimir.
# El secreto solo por entorno; nunca en codigo ni en el repo.
LEO_URL=http://localhost:3100
LEO_API_URL=http://localhost:8100/api/v1
APP_CLIENT_ID=incubus
APP_CLIENT_SECRET=
# URL publica de ESTE backend (fija el htu de DPoP, tambien en el socket).
PUBLIC_URL=http://localhost:8001
COOKIE_SECURE=false
# Opcionales: nombres de cookie (por defecto incubus_access / incubus_refresh /
# incubus_oauth; distintos de los de otras apps porque comparten el host localhost).
# ACCESS_COOKIE_NAME=incubus_access
# REFRESH_COOKIE_NAME=incubus_refresh
# FLOW_COOKIE_NAME=incubus_oauth
