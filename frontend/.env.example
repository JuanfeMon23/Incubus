# Copia este archivo a `.env` y ajusta los valores. `.env` no se versiona.

# URL base de la API (obligatoria). Debe colgar de NUXT_PUBLIC_LEO_API_BASE
# (misma URL del backend + el prefijo /api/v1).
NUXT_PUBLIC_API_BASE=http://localhost:8001/api/v1

# ── Leo (SSO + permisos), transporte `bff`: el navegador habla solo con el backend de Incubus ──
NUXT_PUBLIC_LEO_TRANSPORT=bff
# Backend de Incubus, SIN /api/v1 (aquí viven /auth/login, /auth/me…).
NUXT_PUBLIC_LEO_API_BASE=http://localhost:8001
# = PUBLIC_URL del backend (fija el `htu` de las pruebas DPoP, también las del socket).
NUXT_PUBLIC_LEO_PUBLIC_URL=http://localhost:8001
# = client_id de la app en Leo y nombre a mostrar en la barra superior.
NUXT_PUBLIC_LEO_APP_SLUG=incubus
NUXT_PUBLIC_LEO_APP_NAME=Incubus
# Ruta del FRONTEND que recibe ?code&state; debe coincidir con la redirect_uri
# registrada en Leo (http://localhost:3200/leo/callback) y con APP_REDIRECT_URI del backend.
NUXT_PUBLIC_LEO_CALLBACK_PATH=/leo/callback
NUXT_PUBLIC_LEO_AUTH_PATH=/auth
# Dirección pública del frontend de Leo (enlace "Mi perfil" de la barra superior).
NUXT_PUBLIC_LEO_URL=http://localhost:3100
